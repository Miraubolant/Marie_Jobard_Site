<!DOCTYPE html>
<html>

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title inertia>
      Marie Jobard - Infirmière Puéricultrice
    </title>

    <link rel="icon" type="image/png" href="/images/logo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;500;600;700;800&family=Caveat:wght@400;500;600;700&family=Patrick+Hand&display=swap" rel="stylesheet" />

    @stack('dumper')
    @viteReactRefresh()
    @inertiaHead()
    @vite(['resources/css/app.css', 'resources/js/app/app.tsx', `resources/js/pages/${page.component}.tsx`])
  </head>

  <body class="font-sans relative isolate">
    @inertia()
  </body>

</html>
